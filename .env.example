# Copy to .env.local (git-ignored by the *.local rule) and fill in what you have.
# Every one of these is optional: with none set, the course hero still shows a
# real satellite view of the course and freely-licensed photos from Wikimedia.

# --- SkyFi archive imagery (flagship courses) ---------------------------------
# The URL of a proxy that holds the SkyFi secret and speaks the JSON contract in
# docs/IMAGERY.md. Do NOT point this straight at SkyFi from the browser.
VITE_SKYFI_ENDPOINT=

# Only for local development against a proxy that expects the key passed
# through. Never set this on a public build — the browser can read it.
VITE_SKYFI_API_KEY=

# --- Google Maps Platform (everything else) -----------------------------------
# Restrict the key to this deploy's HTTP referrer in the Google Cloud console
# before shipping it. Places photos are billed per request.
VITE_GOOGLE_MAPS_KEY=
